# Copia este archivo como .env y completa los valores reales.
# NUNCA commitear el archivo .env — ya está en .gitignore.

# URL base del Web Service en la nube (sin slash final)
CLOUD_BASE_URL=https://your-backend.onrender.com

# MAC address de este Edge Node tal como fue registrada en el backend
EDGE_MAC=AA:BB:CC:DD:EE:FF

# MAC address del dispositivo IoT sensor registrado en el backend
IOT_MAC=BB:CC:DD:EE:FF:AA

# API key genérica para otros endpoints (dejar vacío si no aplica)
CLOUD_API_KEY=

# Clave emitida una sola vez por el registro administrativo del gateway.
# Se envía únicamente como X-Gateway-Key al endpoint de ingestión.
CLOUD_GATEWAY_KEY=

# Clave compartida solo entre este Edge API y el firmware del Edge Node.
EDGE_NODE_KEY=

# Credenciales usadas para autenticarse (POST /authentication/sign-in) y
# obtener el JWT que se adjunta a cada request al Web Service. El rol debe
# tener permiso sobre /edge-gateways, /devices/{mac}/thresholds y el registry
# (Administrator cubre todos).
CLOUD_ADMIN_USERNAME=admin
CLOUD_ADMIN_PASSWORD=admin

# Zona informativa del gateway (el registro se realiza desde administración)
MONITORING_ZONE_ID=1

# (Opcional) Id del usuario (PalmGrower) dueño de este edge gateway. Solo se
# usa si el gateway aún no existe en el cloud; si ya fue registrado desde el
# panel de administrador, no hace falta configurarlo.
CLOUD_OWNER_USER_ID=

# Timeout HTTP en segundos para requests al Web Service
CLOUD_TIMEOUT=10

# Ruta al archivo SQLite de datos locales
DATABASE_PATH=edge_data.db

# (Opcional) IPv4 a anunciar por mDNS al Edge Node. Dejar vacío para
# autodetectar la interfaz con ruta por defecto. Configurar solo si la laptop
# tiene varias interfaces (Ethernet + WiFi) y el Edge Node está en la red
# de una interfaz que NO es la de la ruta por defecto.
EDGE_ADVERTISE_IP=

# Activar modo debug de Flask (solo en desarrollo local)
FLASK_DEBUG=false
